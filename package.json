{
  "name": "showcase",
  "version": "0.0.0",
  "author": "Guillaume Quittet",
  "license": "MIT",
  "scripts": {
    "dev": "parcel src/index.html",
    "prebuild": "rimraf ./dist",
    "build": "cross-env NODE_ENV=production parcel build src/index.html --no-source-maps",
    "start": "parcel serve src/index.html",
    "preserve": "rimraf ./dist",
    "serve": "cross-env NODE_ENV=production parcel serve src/index.html --no-source-maps --open",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist -b master"
  },
  "devDependencies": {
    "@parcel/core": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "autoprefixer": "^10.7.0",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "parcel": "^2.16.4",
    "postcss": "^8.5.33",
    "postcss-modules": "^9.1.2",
    "prettier": "3.10.1",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.4"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typeit-react": "^2.7.8"
  }
}
